    </div>
  </section>

  <!-- 8. Finale Heart & Shooting Meteor Wish Fountain -->
  <section id="finale">
    <div class="container">
      <span class="sec-tag reveal">Forever & Always</span>
      <h2 class="sec-title reveal">为芷萱点亮心动</h2>
      <p class="sec-sub reveal">
        每一次触碰，都代表我对你的爱意又多了一分。
      </p>

      <button class="big-heart-btn reveal" id="bigheart" aria-label="为芷萱点亮爱心">
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 28C16 28 3 20 3 11C3 6.5 6.5 3 11 3C13.5 3 15.5 4.5 16 6C16.5 4.5 18.5 3 21 3C25.5 3 29 6.5 29 11C29 20 16 28 16 28Z" fill="url(#finalGrad)"/>
          <defs>
            <linearGradient id="finalGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#ff7597"/>
              <stop offset="100%" stop-color="#ff2e63"/>
            </linearGradient>
          </defs>
        </svg>
      </button>

      <div class="heart-counter reveal" id="heart-count-tip">点击爱心，为芷萱燃放浪漫星火 (已为你心动 <span id="heart-count">1314</span> 次)</div>

      <button class="meteor-wish-btn reveal" id="meteor-btn">向浪漫星空许愿 · 召唤流星雨 ✦</button>
    </div>
  </section>

  <footer>
    ♡ 2026.09.05 · Kim & 颜芷萱 (GAN TZI SHUAN) · 始于峡谷 · 终于白首 · 余生漫漫唯你是解 ♡
  </footer>

  <script>
    /* ==========================================================================
       1. CORE INITIALIZATION & AUDIO (Dual Mode: MP3 Audio + Web Audio Synth)
       ========================================================================== */
    const $ = s => document.querySelector(s);
    let audioCtx = null, isPlaying = false, synthTimer = null, useSynth = false;
    const bgm = $('#bgm');

    // Note frequencies for synth fallback
    const N = {
      C3: 130.81, D3: 146.83, E3: 164.81, F3: 174.61, G3: 196.00, A3: 220.00, B3: 246.94,
      C4: 261.63, D4: 293.66, E4: 329.63, F4: 349.23, G4: 392.00, A4: 440.00, B4: 493.88,
      C5: 523.25, D5: 587.33, E5: 659.25, F5: 698.46, G5: 783.99, A5: 880.00,
      REST: 0
    };

    function playNote(freq, dur, gainVal = 0.075) {
      if (!audioCtx || freq <= 0) return;
      const t = audioCtx.currentTime;
      const osc1 = audioCtx.createOscillator();
      const osc2 = audioCtx.createOscillator();
      const g = audioCtx.createGain();

      osc1.type = 'sine';
      osc1.frequency.setValueAtTime(freq, t);
      osc2.type = 'triangle';
      osc2.frequency.setValueAtTime(freq * 2, t);

      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(gainVal, t + 0.03);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);

      osc1.connect(g);
      osc2.connect(g);
      g.connect(audioCtx.destination);

      osc1.start(t);
      osc2.start(t);
      osc1.stop(t + dur);
      osc2.stop(t + dur);
    }

    const LOVE_STORY_SCORE = [
      { m: N.E4, b: N.C3, d: 0.35 }, { m: N.F4, b: N.G3, d: 0.35 }, { m: N.G4, b: N.E4, d: 0.45 },
      { m: N.G4, b: N.C3, d: 0.35 }, { m: N.G4, b: N.G3, d: 0.35 }, { m: N.A4, b: N.E4, d: 0.35 },
      { m: N.G4, b: N.C3, d: 0.35 }, { m: N.F4, b: N.G3, d: 0.3 }, { m: N.E4, b: N.E4, d: 0.3 }, { m: N.D4, b: N.G3, d: 0.75 },
      { m: N.E4, b: N.G3, d: 0.35 }, { m: N.F4, b: N.B3, d: 0.35 }, { m: N.G4, b: N.D4, d: 0.45 },
      { m: N.G4, b: N.G3, d: 0.35 }, { m: N.G4, b: N.B3, d: 0.35 }, { m: N.A4, b: N.D4, d: 0.35 },
      { m: N.G4, b: N.G3, d: 0.35 }, { m: N.F4, b: N.B3, d: 0.3 }, { m: N.E4, b: N.C4, d: 0.75 },
      { m: N.E4, b: N.A3, d: 0.35 }, { m: N.F4, b: N.C4, d: 0.35 }, { m: N.G4, b: N.E4, d: 0.4 },
      { m: N.C5, b: N.A3, d: 0.65 }, { m: N.C5, b: N.C4, d: 0.35 }, { m: N.B4, b: N.E4, d: 0.35 },
      { m: N.A4, b: N.A3, d: 0.35 }, { m: N.G4, b: N.C4, d: 0.35 }, { m: N.F4, b: N.E4, d: 0.3 }, { m: N.E4, b: N.F3, d: 0.6 },
      { m: N.E4, b: N.F3, d: 0.35 }, { m: N.F4, b: N.C4, d: 0.35 }, { m: N.G4, b: N.A3, d: 0.55 },
      { m: N.D4, b: N.G3, d: 0.45 }, { m: N.D4, b: N.B3, d: 0.35 }, { m: N.C4, b: N.D4, d: 0.35 },
      { m: N.D4, b: N.G3, d: 0.35 }, { m: N.E4, b: N.G4, d: 0.45 }, { m: N.C4, b: N.C3, d: 1.1 }
    ];

    let notePointer = 0;
    function playNextLoveStoryNote() {
      if (!isPlaying || !useSynth) return;
      const item = LOVE_STORY_SCORE[notePointer];
      if (item.m > 0) playNote(item.m, item.d * 1.5, 0.08);
      if (item.b > 0) playNote(item.b, item.d * 2.0, 0.04);
      notePointer = (notePointer + 1) % LOVE_STORY_SCORE.length;
      synthTimer = setTimeout(playNextLoveStoryNote, item.d * 1000);
    }

    function startSynthLoveStory() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();
      useSynth = true;
      isPlaying = true;
      syncMusicUI(true);
      clearTimeout(synthTimer);
      playNextLoveStoryNote();
    }

    function syncMusicUI(playing) {
      $('#mute-btn').classList.toggle('playing', playing);
      const disc = $('#vinyl-disc');
      if (disc) disc.classList.toggle('spinning', playing);
      const vBtn = $('#vinyl-btn');
      if (vBtn) vBtn.textContent = playing ? '暂停播放 ⏸' : '继续播放 ♫';
    }

    function stopAllMusic() {
      isPlaying = false;
      syncMusicUI(false);
      clearTimeout(synthTimer);
      if (bgm) bgm.pause();
    }

    function startAudio() {
      if (bgm) {
        if (!bgm.src) bgm.src = 'lovestory.mp3';
        const p = bgm.play();
        if (p !== undefined) {
          p.then(() => {
            isPlaying = true;
            useSynth = false;
            syncMusicUI(true);
          }).catch(err => {
            console.warn('Local play failed, trying CDN fallback:', err);
            if (!bgm.src.includes('raw.githubusercontent.com')) {
              bgm.src = 'https://raw.githubusercontent.com/YiLin-East/MyMusic/main/Taylor%20Swift%20-%20Love%20Story.mp3';
              bgm.play().then(() => {
                isPlaying = true;
                useSynth = false;
                syncMusicUI(true);
              }).catch(() => startSynthLoveStory());
            } else {
              startSynthLoveStory();
            }
          });
          return;
        }
      }
      startSynthLoveStory();
    }

    $('#mute-btn').onclick = () => {
      if (isPlaying) stopAllMusic();
      else startAudio();
    };
    $('#vinyl-btn').onclick = () => {
      if (isPlaying) stopAllMusic();
      else startAudio();
    };

    /* ==========================================================================
       2. LOVE TIMER (Strictly Anniversary Date: 2026-09-05)
       ========================================================================== */
    const START_DATE = new Date(2026, 8, 5, 0, 0, 0);

    function updateTimer() {
      const now = new Date();
      const diff = now - START_DATE;
      const absDiff = Math.abs(diff);

      const days = Math.floor(absDiff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((absDiff / (1000 * 60 * 60)) % 24);
      const mins = Math.floor((absDiff / (1000 * 60)) % 60);
      const secs = Math.floor((absDiff / 1000) % 60);

      const dEl = $('#t-days'), hEl = $('#t-hours'), mEl = $('#t-mins'), sEl = $('#t-secs');
      if (dEl) dEl.textContent = days;
      if (hEl) hEl.textContent = hours;
      if (mEl) mEl.textContent = mins;
      if (sEl) sEl.textContent = secs;
    }
    setInterval(updateTimer, 1000);
    updateTimer();

    /* ==========================================================================
       3. MULTILINGUAL CYCLING
       ========================================================================== */
    const L = [
      { t: "我爱你", n: "粤语" },
      { t: "I Love You", n: "英语" },
      { t: "Je t'aime", n: "法语" },
      { t: "Ti amo", n: "意大利语" },
      { t: "사랑해", n: "韩语" },
      { t: "愛してる", n: "日语" },
      { t: "Te amo", n: "西班牙语" },
      { t: "Ich liebe dich", n: "德语" },
      { t: "Я люблю тебя", n: "俄语" }
    ];
    const cy = $('#cycle-box');
    let ci = 0;
    if (cy) {
      setInterval(() => {
        cy.classList.add('out');
        setTimeout(() => {
          ci = (ci + 1) % L.length;
          cy.querySelector('b').textContent = L[ci].t;
          cy.querySelector('small').textContent = L[ci].n;
          cy.classList.remove('out');
        }, 400);
      }, 3200);
    }

    /* ==========================================================================
       4. SCROLL REVEAL (Intersection Observer)
       ========================================================================== */
    const io = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));

    /* ==========================================================================
       5. WECHAT SIMULATOR DATA
       ========================================================================== */
    const CHAT_CHAPTERS = [
      {
        title: "初加微信 · 彼此试探的甜",
        msgs: [
          { time: "初次相遇的那个傍晚" },
          { sender: "boy", text: "刚刚王者峡谷里配合得太默契啦，我来微信打个招呼～" },
          { sender: "girl", text: "哈哈通过啦！你中单法王玩得好帅气，全场节奏拉满 (≧∇≦)" },
          { sender: "boy", text: "主要是芷萱辅助得好，护盾每次都给得刚刚好，有你保护法王更安心。" },
          { sender: "girl", text: "噗，你平时也是法王常胜将军吗？" },
          { sender: "boy", text: "遇到你之前随缘玩，遇到你之后只想把把赢给你看。" },
          { sender: "girl", text: "哎呀突然这么会夸，我都害羞了～" },
          { sender: "boy", text: "说的是真心话呀。芷萱，晚饭吃了没？" },
          { sender: "girl", text: "刚准备去吃呢，你快去吃！" }
        ]
      },
      {
        title: "日常升温 · 习惯每一刻有你",
        msgs: [
          { time: "某天阳光明媚的午后" },
          { sender: "boy", text: "芷萱，今天给你点了半糖奶茶，收到没？" },
          { sender: "girl", text: "天哪收到啦！你怎么知道我喜欢这个牌子呀？" },
          { sender: "boy", text: "因为你说过的每一句话，我都偷偷记在备忘录里了。" },
          { sender: "girl", text: "呜呜感动死啦，怎么会有这么细心的法王大人～" },
          { sender: "boy", text: "以后你的所有喜好，都有我专门承包。" },
          { sender: "girl", text: "那下班了继续峡谷双排嘛？我今天蔡文姬超猛！" },
          { sender: "boy", text: "必须的，今晚蓝Buff和人头全给你！" }
        ]
      },
      {
        title: "定情告白 · 2026年9月5日",
        msgs: [
          { time: "2026年9月5日 · 深夜星光下" },
          { sender: "boy", text: "芷萱，睡了嘛？" },
          { sender: "girl", text: "还没呢，在看着窗外的月亮发呆，怎么啦？" },
          { sender: "boy", text: "从打王者认识，到微信每天和你聊天，不知不觉已经成了我生命里最最重要的习惯。" },
          { sender: "girl", text: "我也是呢……每天看到你的消息都会忍不住笑。" },
          { sender: "boy", text: "颜芷萱，今天正好是2026年9月5日，我想正式向你申请：做我唯一的女朋友好吗？" },
          { sender: "girl", text: "笨蛋，我等这句话好久啦……我愿意！♥" },
          { sender: "boy", text: "我爱你，芷萱！余生请多指教！" }
        ]
      }
    ];

    let currentChatTab = 0, currentChatMsgIdx = 0;
    const chatBody = $('#chat-messages');

    function renderCurrentChat() {
      chatBody.innerHTML = '';
      const chap = CHAT_CHAPTERS[currentChatTab];
      for (let i = 0; i <= currentChatMsgIdx && i < chap.msgs.length; i++) {
        const m = chap.msgs[i];
        if (m.time) {
          const t = document.createElement('div');
          t.className = 'chat-time-center';
          t.textContent = m.time;
          chatBody.appendChild(t);
        } else {
          const row = document.createElement('div');
          row.className = 'chat-bubble-row ' + m.sender;
          const av = document.createElement('div');
          av.className = 'chat-avatar ' + (m.sender === 'girl' ? 'girl-av' : 'boy-av');
          av.textContent = m.sender === 'girl' ? '萱' : 'Kim';
          const bub = document.createElement('div');
          bub.className = 'chat-bubble ' + (m.sender === 'girl' ? 'girl-msg' : 'boy-msg');
          bub.textContent = m.text;
          row.appendChild(av);
          row.appendChild(bub);
          chatBody.appendChild(row);
        }
      }
      chatBody.scrollTop = chatBody.scrollHeight;
      const statusEl = $('#chat-status');
      if (statusEl) {
        statusEl.textContent = `记录 ${Math.min(currentChatMsgIdx + 1, chap.msgs.length)} / ${chap.msgs.length}`;
      }
    }

    document.querySelectorAll('.chat-tab-btn').forEach(btn => {
      btn.onclick = () => {
        document.querySelectorAll('.chat-tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentChatTab = parseInt(btn.dataset.tab, 10);
        currentChatMsgIdx = 1;
        renderCurrentChat();
      };
    });

    $('#chat-next-btn').onclick = () => {
      const chap = CHAT_CHAPTERS[currentChatTab];
      if (currentChatMsgIdx < chap.msgs.length - 1) {
        currentChatMsgIdx++;
        renderCurrentChat();
      } else {
        currentChatTab = (currentChatTab + 1) % CHAT_CHAPTERS.length;
        document.querySelectorAll('.chat-tab-btn').forEach((b, i) => {
          b.classList.toggle('active', i === currentChatTab);
        });
        currentChatMsgIdx = 1;
        renderCurrentChat();
      }
    };
    renderCurrentChat();

    /* ==========================================================================
       6. OFFSCREEN SPRITES (High-speed hardware acceleration)
       ========================================================================== */
    const spritePink = document.createElement('canvas');
    spritePink.width = 32; spritePink.height = 32;
    const pCtx = spritePink.getContext('2d');
    const gradP = pCtx.createRadialGradient(16, 16, 0, 16, 16, 16);
    gradP.addColorStop(0, 'rgba(255, 140, 175, 1)');
    gradP.addColorStop(0.4, 'rgba(255, 77, 121, 0.7)');
    gradP.addColorStop(1, 'rgba(255, 77, 121, 0)');
    pCtx.fillStyle = gradP;
    pCtx.beginPath(); pCtx.arc(16, 16, 16, 0, 6.28); pCtx.fill();

    const spriteGold = document.createElement('canvas');
    spriteGold.width = 32; spriteGold.height = 32;
    const gCtx = spriteGold.getContext('2d');
    const gradG = gCtx.createRadialGradient(16, 16, 0, 16, 16, 16);
    gradG.addColorStop(0, 'rgba(255, 250, 220, 1)');
    gradG.addColorStop(0.4, 'rgba(246, 210, 137, 0.8)');
    gradG.addColorStop(1, 'rgba(246, 210, 137, 0)');
    gCtx.fillStyle = gradG;
    gCtx.beginPath(); gCtx.arc(16, 16, 16, 0, 6.28); gCtx.fill();

    /* ==========================================================================
       7. DEDICATED NAME-HEART-CANVAS (Locks precisely on 颜芷萱)
       ========================================================================== */
    const nhCv = $('#name-heart-canvas');
    const nq = nhCv.getContext('2d');
    let NW = 0, NH = 0, ND = 1, heartScale = 10, isStoryStarted = false, nhFrame = 0;
    const NameParticles = [];

    function resizeNameHeartCanvas() {
      const wrap = $('.hero-name-wrap');
      if (!wrap) return;
      ND = Math.min(window.devicePixelRatio || 1, 2);
      NW = Math.min(window.innerWidth * 0.94, 520);
      NH = Math.min(window.innerWidth * 0.88, 420);
      nhCv.width = NW * ND;
      nhCv.height = NH * ND;
      nhCv.style.width = NW + 'px';
      nhCv.style.height = NH + 'px';
      nq.setTransform(ND, 0, 0, ND, 0, 0);
      heartScale = Math.min(NW * 0.027, NH * 0.026);
    }
    window.addEventListener('resize', resizeNameHeartCanvas);
    resizeNameHeartCanvas();

    function initNameHeart() {
      NameParticles.length = 0;
      [1.0, 0.88].forEach(layer => {
        const count = layer === 1.0 ? 80 : 50;
        for (let i = 0; i < count; i++) {
          const t = (i / count) * Math.PI * 2;
          const hx = 16 * Math.sin(t) ** 3;
          const hy = -(13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));
          NameParticles.push({
            tx: hx * layer,
            ty: hy * layer,
            x: (Math.random() - 0.5) * 600,
            y: (Math.random() - 0.5) * 600,
            r: Math.random() * 2.2 + 2.0,
            gold: Math.random() < 0.25,
            delay: Math.random() * 40
          });
        }
      });
    }
    initNameHeart();

    function renderNameHeart(time) {
      if (!NW) return;
      nq.clearRect(0, 0, NW, NH);
      const cx = NW / 2;
      const cy = NH / 2 + 5;
      const beat = 1 + 0.04 * Math.pow(Math.max(0, Math.sin(time * 3)), 3);

      NameParticles.forEach(p => {
        if (isStoryStarted) {
          if (nhFrame > p.delay) {
            p.x += (p.tx * heartScale * beat - p.x) * 0.06;
            p.y += (p.ty * heartScale * beat - p.y) * 0.06;
          }
        }
        const img = p.gold ? spriteGold : spritePink;
        const diam = p.r * 5;
        nq.drawImage(img, cx + p.x - diam / 2, cy + p.y - diam / 2, diam, diam);
      });
      if (isStoryStarted) nhFrame++;
    }

    /* ==========================================================================
       8. BACKGROUND CANVAS: NEBULA, AURORA, METEORS & GLOWING FIREFLIES
       ========================================================================== */
    const bgCv = $('#bg-canvas'), bq = bgCv.getContext('2d');
    const fxCv = $('#fx-canvas'), fq = fxCv.getContext('2d');
    let FW = 0, FH = 0, FD = 1;

    function resizeFullCanvas() {
      FD = Math.min(window.devicePixelRatio || 1, 2);
      FW = window.innerWidth;
      FH = window.innerHeight;
      bgCv.width = FW * FD; bgCv.height = FH * FD;
      bq.setTransform(FD, 0, 0, FD, 0, 0);
      fxCv.width = FW * FD; fxCv.height = FH * FD;
      fq.setTransform(FD, 0, 0, FD, 0, 0);
    }
    window.addEventListener('resize', resizeFullCanvas);
    resizeFullCanvas();

    // 1. Shimmering Star Clusters with diffraction cross spikes
    const Stars = [];
    for (let i = 0; i < 95; i++) {
      Stars.push({
        x: Math.random(),
        y: Math.random(),
        r: Math.random() * 1.6 + 0.6,
        p: Math.random() * 6.28,
        cross: Math.random() < 0.25,
        color: ['#fff', '#ffe6ee', '#e6f7ff', '#fff4d6'][Math.floor(Math.random() * 4)]
      });
    }

    // 2. Shooting Stars (流星雨)
    const Meteors = [];
    function spawnMeteor(forced = false) {
      const startX = Math.random() * FW * 0.8 + FW * 0.2;
      const startY = Math.random() * FH * 0.4;
      const speed = Math.random() * 12 + 16;
      Meteors.push({
        x: startX,
        y: startY,
        vx: -speed * 0.8,
        vy: speed * 0.6,
        len: Math.random() * 90 + 70,
        alpha: 1,
        fade: 0.018,
        color: Math.random() < 0.5 ? '#f6d289' : '#ff85a2'
      });
    }

    // 3. Floating Bioluminescent Fireflies (荧光微光微粒)
    const Fireflies = [];
    for (let i = 0; i < 35; i++) {
      Fireflies.push({
        x: Math.random() * window.innerWidth,
        y: Math.random() * window.innerHeight,
        r: Math.random() * 2 + 1.2,
        vx: (Math.random() - 0.5) * 0.5,
        vy: -Math.random() * 0.7 - 0.3,
        pulse: Math.random() * 6.28,
        color: Math.random() < 0.6 ? '#f6d289' : '#ff7597'
      });
    }

    // 4. Continuous Realistic Falling Petals (3D fluttering)
    const FallingPetals = [];
    for (let i = 0; i < 26; i++) {
      FallingPetals.push({
        x: Math.random() * window.innerWidth,
        y: Math.random() * window.innerHeight,
        size: Math.random() * 9 + 11,
        vx: (Math.random() - 0.5) * 0.6,
        vy: Math.random() * 1.0 + 1.2,
        rot: Math.random() * 6.28,
        vRot: (Math.random() - 0.5) * 0.03,
        rotY: Math.random() * 6.28,
        vRotY: Math.random() * 0.03 + 0.02,
        color: ['#ff8ca3', '#ff4d79', '#ffa8bc', '#ffd0db'][Math.floor(Math.random() * 4)],
        alpha: Math.random() * 0.3 + 0.65
      });
    }

    // Interactive particles & romantic text popups
    const FxParticles = [];
    const FxWords = [];
    const SWEET_WORDS = [
      "颜芷萱 ♥", "2026.09.05", "喜欢你", "中单法王", "心动 +1",
      "永远爱你", "Kim ♥ 芷萱", "+1314♥", "余生都是你", "命中注定",
      "我的女孩", "超爱你啦", "温柔沦陷", "法王独宠", "唯你是解"
    ];

    function spawnClickBurst(x, y) {
      for (let i = 0; i < 9; i++) {
        const ang = Math.random() * 6.28;
        const spd = Math.random() * 4.5 + 2;
        FxParticles.push({
          kind: 'petal', x, y,
          vx: Math.cos(ang) * spd,
          vy: Math.sin(ang) * spd - 2,
          size: Math.random() * 8 + 10,
          rot: Math.random() * 6.28,
          vRot: (Math.random() - 0.5) * 0.05,
          color: ['#ff4d79', '#ff7597', '#ffb3c1', '#ffd0db'][Math.floor(Math.random() * 4)],
          alpha: 1, fade: 0.02
        });
      }
      for (let i = 0; i < 7; i++) {
        const ang = Math.random() * 6.28;
        const spd = Math.random() * 3 + 1.5;
        FxParticles.push({
          kind: 'heart', x, y,
          vx: Math.cos(ang) * spd,
          vy: Math.sin(ang) * spd - 2.5,
          size: Math.random() * 10 + 12,
          alpha: 1, fade: 0.022
        });
      }
      for (let i = 0; i < 12; i++) {
        const ang = Math.random() * 6.28;
        const spd = Math.random() * 5 + 1;
        FxParticles.push({
          kind: 'spark', x, y,
          vx: Math.cos(ang) * spd,
          vy: Math.sin(ang) * spd - 1.5,
          size: Math.random() * 3 + 2,
          color: Math.random() < 0.4 ? '#f6d289' : '#ff85a2',
          alpha: 1, fade: 0.03
        });
      }
      const w = SWEET_WORDS[Math.floor(Math.random() * SWEET_WORDS.length)];
      FxWords.push({
        text: w, x, y: y - 10, vy: -1.2, alpha: 1,
        color: Math.random() < 0.5 ? '#f6d289' : '#ff85a2'
      });
    }

    window.addEventListener('pointerdown', e => {
      if (e.target.closest('button') && !e.target.closest('#bigheart') && !e.target.closest('#seal-btn') && !e.target.closest('#meteor-btn')) return;
      spawnClickBurst(e.clientX, e.clientY);
    });

    function drawMiniHeart(ctx, x, y, size, alpha) {
      ctx.save();
      ctx.translate(x, y);
      ctx.globalAlpha = Math.max(0, alpha);
      ctx.fillStyle = '#ff4d79';
      ctx.beginPath();
      const s = size / 24;
      ctx.moveTo(0, 8 * s);
      ctx.bezierCurveTo(-12 * s, -6 * s, -14 * s, 10 * s, 0, 18 * s);
      ctx.bezierCurveTo(14 * s, 10 * s, 12 * s, -6 * s, 0, 8 * s);
      ctx.fill();
      ctx.restore();
    }

    // Master Render Loop
    function masterLoop(now) {
      requestAnimationFrame(masterLoop);
      const t = now / 1000;

      // 1. Render name heart
      renderNameHeart(t);

      // 2. Render background ambient canvas
      bq.clearRect(0, 0, FW, FH);

      // Star clusters
      Stars.forEach(s => {
        const a = 0.25 + 0.5 * Math.sin(t * 1.5 + s.p);
        bq.globalAlpha = a;
        bq.fillStyle = s.color;
        bq.beginPath();
        bq.arc(s.x * FW, s.y * FH, s.r, 0, 6.28);
        bq.fill();
        if (s.cross && a > 0.5) {
          bq.strokeStyle = 'rgba(255, 255, 255, 0.4)';
          bq.lineWidth = 0.6;
          bq.beginPath();
          bq.moveTo(s.x * FW - 5, s.y * FH);
          bq.lineTo(s.x * FW + 5, s.y * FH);
          bq.moveTo(s.x * FW, s.y * FH - 5);
          bq.lineTo(s.x * FW, s.y * FH + 5);
          bq.stroke();
        }
      });

      // Periodic Shooting Meteors
      if (Math.random() < 0.012 && Meteors.length < 3) {
        spawnMeteor();
      }
      for (let i = Meteors.length - 1; i >= 0; i--) {
        const m = Meteors[i];
        m.x += m.vx;
        m.y += m.vy;
        m.alpha -= m.fade;
        if (m.alpha <= 0) {
          Meteors.splice(i, 1);
          continue;
        }
        bq.save();
        bq.globalAlpha = Math.max(0, m.alpha);
        const grad = bq.createLinearGradient(m.x, m.y, m.x - m.vx * 2, m.y - m.vy * 2);
        grad.addColorStop(0, '#fff');
        grad.addColorStop(0.3, m.color);
        grad.addColorStop(1, 'transparent');
        bq.strokeStyle = grad;
        bq.lineWidth = 2.2;
        bq.beginPath();
        bq.moveTo(m.x, m.y);
        bq.lineTo(m.x - m.vx * 2.5, m.y - m.vy * 2.5);
        bq.stroke();
        bq.restore();
      }

      // Bioluminescent Fireflies
      Fireflies.forEach(f => {
        f.x += f.vx + Math.sin(t + f.pulse) * 0.4;
        f.y += f.vy;
        if (f.y < -20) {
          f.y = FH + 20;
          f.x = Math.random() * FW;
        }
        const a = 0.3 + 0.5 * Math.sin(t * 2 + f.pulse);
        bq.globalAlpha = Math.max(0, a);
        bq.fillStyle = f.color;
        bq.shadowColor = f.color;
        bq.shadowBlur = 8;
        bq.beginPath();
        bq.arc(f.x, f.y, f.r, 0, 6.28);
        bq.fill();
        bq.shadowBlur = 0;
      });
      bq.globalAlpha = 1;

      // 3. Render foreground FX
      fq.clearRect(0, 0, FW, FH);

      // Falling petals
      FallingPetals.forEach(p => {
        p.y += p.vy;
        p.x += p.vx + Math.sin(t + p.y * 0.01) * 0.4;
        p.rot += p.vRot;
        p.rotY += p.vRotY;
        if (p.y > FH + 20) {
          p.y = -20;
          p.x = Math.random() * FW;
        }
        fq.save();
        fq.translate(p.x, p.y);
        fq.rotate(p.rot);
        const sx = Math.cos(p.rotY);
        fq.scale(Math.abs(sx) < 0.1 ? 0.1 : sx, 1);
        fq.globalAlpha = p.alpha;
        fq.fillStyle = p.color;
        fq.beginPath();
        fq.moveTo(0, -p.size);
        fq.bezierCurveTo(p.size * 0.7, -p.size * 0.6, p.size * 0.8, p.size * 0.5, 0, p.size);
        fq.bezierCurveTo(-p.size * 0.8, p.size * 0.5, -p.size * 0.7, -p.size * 0.6, 0, -p.size);
        fq.fill();
        fq.restore();
      });

      // Click burst particles
      for (let i = FxParticles.length - 1; i >= 0; i--) {
        const p = FxParticles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= p.fade;
        if (p.alpha <= 0) {
          FxParticles.splice(i, 1);
          continue;
        }
        if (p.kind === 'heart') {
          drawMiniHeart(fq, p.x, p.y, p.size, p.alpha);
        } else if (p.kind === 'spark') {
          fq.globalAlpha = Math.max(0, p.alpha);
          fq.fillStyle = p.color;
          fq.beginPath();
          fq.arc(p.x, p.y, p.size, 0, 6.28);
          fq.fill();
        } else if (p.kind === 'petal') {
          p.rot += p.vRot;
          fq.save();
          fq.translate(p.x, p.y);
          fq.rotate(p.rot);
          fq.globalAlpha = Math.max(0, p.alpha);
          fq.fillStyle = p.color;
          fq.beginPath();
          fq.ellipse(0, 0, p.size * 0.5, p.size * 0.9, 0, 0, 6.28);
          fq.fill();
          fq.restore();
        }
      }

      // Floating words
      for (let i = FxWords.length - 1; i >= 0; i--) {
        const w = FxWords[i];
        w.y += w.vy;
        w.alpha -= 0.016;
        if (w.alpha <= 0) {
          FxWords.splice(i, 1);
          continue;
        }
        fq.save();
        fq.font = 'bold 14px "Noto Serif SC", sans-serif';
        fq.textAlign = 'center';
        fq.globalAlpha = Math.max(0, w.alpha);
        fq.fillStyle = w.color;
        fq.shadowColor = 'rgba(0,0,0,0.8)';
        fq.shadowBlur = 6;
        fq.fillText(w.text, w.x, w.y);
        fq.restore();
      }
    }
    requestAnimationFrame(masterLoop);

    /* ==========================================================================
       9. GATE BUTTON TRIGGER
       ========================================================================== */
    $('#gate-btn').onclick = () => {
      $('#gate').classList.add('off');
      isStoryStarted = true;
      startAudio();
      const wrap = $('.hero-name-wrap');
      if (wrap) {
        const r = wrap.getBoundingClientRect();
        spawnClickBurst(r.left + r.width / 2, r.top + r.height / 2);
      }
    };

    /* ==========================================================================
       10. ULTRA-HD CINEMATIC THEATRE ENGINE (ANIME VISUAL NOVEL PRESENTATION)
       - NO MORE STICK FIGURES!
       - Dazzling Anime Spell Beams, Victory Wings, Floating WeChat Cards, Fireworks
       ========================================================================== */
    const tc = $('#theatre-canvas'), tq = tc.getContext('2d');
    let TW = 0, TH = 0, TD = 1;
    let currentAct = 0, actProgress = 0, isTheatrePaused = false;

    function resizeTheatreCanvas() {
      const box = $('#theatre-stage');
      if (!box) return;
      TD = Math.min(window.devicePixelRatio || 1, 2);
      TW = box.clientWidth;
      TH = box.clientHeight;
      tc.width = TW * TD;
      tc.height = TH * TD;
      tq.setTransform(TD, 0, 0, TD, 0, 0);
    }
    window.addEventListener('resize', resizeTheatreCanvas);
    resizeTheatreCanvas();

    const THEATRE_ACTS = [
      {
        badge: "⚔️ 峡谷激战 · 法王大招收割！",
        sub: "法术暴击 520520! · 心动护盾 +1314♥",
        speaker: "Kim · 中单法王",
        text: "“芷萱跟紧我，中单法王带飞，蓝Buff人头全给你！”",
        kimX: 0.16, zhiX: 0.84, kimScale: 1.05, zhiScale: 1.05
      },
      {
        badge: "🏆 绝杀水晶 · 胜利封神 VICTORY！",
        sub: "★ MVP 最佳拍档：Kim & 芷萱 · 默契值 100% ★",
        speaker: "芷萱 · 仙子辅助",
        text: "“法王太猛啦！护盾给上，一把直接超神！”",
        kimX: 0.25, zhiX: 0.75, kimScale: 1.1, zhiScale: 1.1
      },
      {
        badge: "💌 赛后心动 · “加个微信吧？”",
        sub: "已通过好友验证 ✓ · 故事翻开新的一页",
        speaker: "Kim · 中单法王",
        text: "“刚刚好默契，加个微信下把继续呀？” “好呀通过啦～”",
        kimX: 0.32, zhiX: 0.68, kimScale: 1.15, zhiScale: 1.15
      },
      {
        badge: "🌙 深夜慢聊 · 习惯每一刻有你",
        sub: "从王者峡谷聊到日常点滴 · 日夜长聊心动升温",
        speaker: "微信里的我们",
        text: "“晚安哦，明天也要一起打游戏、一起分享生活。”",
        kimX: 0.35, zhiX: 0.65, kimScale: 1.2, zhiScale: 1.2
      },
      {
        badge: "💍 2026年9月5日 · 水到渠成定情！",
        sub: "♡ 从王者峡谷到现实余生 · 做我唯一的女朋友吧！ ♡",
        speaker: "Kim 向 芷萱 告白",
        text: "“2026年9月5日：颜芷萱，做我女朋友吧！余生请多指教，我的女孩。”",
        kimX: 0.40, zhiX: 0.60, kimScale: 1.25, zhiScale: 1.25
      }
    ];

    // Theatre Animation Loop
    function theatreLoop(now) {
      requestAnimationFrame(theatreLoop);
      if (!TW || isTheatrePaused) return;
      const t = now / 1000;

      tq.clearRect(0, 0, TW, TH);

      // 1. Draw Canyon Battleground Lighting & Atmosphere
      const grad = tq.createRadialGradient(TW / 2, TH * 0.7, 50, TW / 2, TH * 0.7, TW * 0.8);
      grad.addColorStop(0, 'rgba(0, 242, 254, 0.12)');
      grad.addColorStop(0.5, 'rgba(255, 77, 121, 0.08)');
      grad.addColorStop(1, 'transparent');
      tq.fillStyle = grad;
      tq.fillRect(0, 0, TW, TH);

            // Act-Specific Ultra-HD Anime Cinematic FX
      if (currentAct === 0) {
        // Act 0: Arcane Spell Storm & Magic Circles
        tq.save();
        // Pulsing magic circles at Kim's position
        const kx = TW * 0.22, ky = TH * 0.42;
        tq.strokeStyle = 'rgba(0, 242, 254, 0.7)';
        tq.lineWidth = 2.5;
        tq.shadowColor = '#00f2fe';
        tq.shadowBlur = 18;
        tq.beginPath();
        tq.arc(kx, ky, 35 + Math.sin(t * 6) * 4, 0, 6.28);
        tq.stroke();

        // Laser spell beam blasting towards center
        const gradBeam = tq.createLinearGradient(kx, ky, TW * 0.58, ky);
        gradBeam.addColorStop(0, '#fff');
        gradBeam.addColorStop(0.3, '#00f2fe');
        gradBeam.addColorStop(1, 'rgba(0, 242, 254, 0)');
        tq.strokeStyle = gradBeam;
        tq.lineWidth = 5 + Math.sin(t * 15) * 2;
        tq.beginPath();
        tq.moveTo(kx, ky);
        tq.lineTo(TW * 0.58, ky + Math.sin(t * 8) * 8);
        tq.stroke();

        // Floating Sakura & Healing Aura at Zhixuan's position
        const zx = TW * 0.78, zy = TH * 0.42;
        tq.strokeStyle = 'rgba(255, 117, 151, 0.7)';
        tq.shadowColor = '#ff7597';
        tq.shadowBlur = 18;
        tq.beginPath();
        tq.arc(zx, zy, 35 + Math.sin(t * 6 + 1) * 4, 0, 6.28);
        tq.stroke();
        tq.restore();
      } else if (currentAct === 1) {
        // Act 1: 3D Golden Victory Wings & Raining Confetti
        tq.save();
        tq.translate(TW / 2, TH * 0.35);

        // Radiant Sunburst Rays
        for (let i = 0; i < 12; i++) {
          const ang = (i / 12) * 6.28 + t * 0.4;
          tq.strokeStyle = 'rgba(246, 210, 137, 0.28)';
          tq.lineWidth = 4;
          tq.beginPath();
          tq.moveTo(0, 0);
          tq.lineTo(Math.cos(ang) * 180, Math.sin(ang) * 180);
          tq.stroke();
        }

        // Golden Victory Crest Wings
        tq.fillStyle = '#f6d289';
        tq.shadowColor = '#f6d289';
        tq.shadowBlur = 20;
        tq.beginPath();
        tq.moveTo(0, -15);
        tq.quadraticCurveTo(-75, -50, -120, -15);
        tq.quadraticCurveTo(-60, 25, 0, 18);
        tq.quadraticCurveTo(60, 25, 120, -15);
        tq.quadraticCurveTo(75, -50, 0, -15);
        tq.fill();

        // Banner text
        tq.font = '900 24px "Noto Serif SC", sans-serif';
        tq.fillStyle = '#2c0e18';
        tq.textAlign = 'center';
        tq.textBaseline = 'middle';
        tq.fillText('VICTORY 胜利', 0, 2);

        // Confetti pieces
        for (let i = 0; i < 20; i++) {
          const cx = Math.sin(t * 2 + i) * 140;
          const cy = (t * 80 + i * 25) % (TH * 0.6) - TH * 0.2;
          tq.fillStyle = ['#f6d289', '#ff4d79', '#00f2fe', '#fff'][i % 4];
          tq.fillRect(cx, cy, 6, 6);
        }
        tq.restore();
      } else if (currentAct === 2) {
        // Act 2: Holographic WeChat Bridge & Orbiting Hearts
        tq.save();
        tq.strokeStyle = '#07c160';
        tq.lineWidth = 3;
        tq.shadowColor = '#07c160';
        tq.shadowBlur = 15;
        tq.setLineDash([8, 6]);
        tq.lineDashOffset = -t * 25;
        tq.beginPath();
        tq.moveTo(TW * 0.32, TH * 0.42);
        tq.lineTo(TW * 0.68, TH * 0.42);
        tq.stroke();
        tq.setLineDash([]);

        // Orbiting glowing heart in center
        drawMiniHeart(tq, TW / 2, TH * 0.38 + Math.sin(t * 4) * 6, 32, 1);
        tq.restore();
      } else if (currentAct === 3) {
        // Act 3: Makoto Shinkai Giant Luminous Moon & Stardust
        tq.save();
        tq.fillStyle = '#f6d289';
        tq.shadowColor = '#f6d289';
        tq.shadowBlur = 35;
        tq.beginPath();
        tq.arc(TW / 2, TH * 0.28, 36, 0, 6.28);
        tq.fill();
        tq.fillStyle = '#1c1032';
        tq.beginPath();
        tq.arc(TW / 2 + 12, TH * 0.25, 32, 0, 6.28);
        tq.fill();

        // Fireflies dancing between them
        for (let i = 0; i < 15; i++) {
          const fx = TW * 0.3 + (i / 15) * TW * 0.4 + Math.sin(t * 2 + i) * 15;
          const fy = TH * 0.35 + Math.cos(t * 3 + i) * 20;
          tq.fillStyle = '#f6d289';
          tq.beginPath();
          tq.arc(fx, fy, 2, 0, 6.28);
          tq.fill();
        }
        tq.restore();
      } else if (currentAct === 4) {
        // Act 4: Fireworks & Grand Glowing Particle Heart
        tq.save();
        drawMiniHeart(tq, TW / 2, TH * 0.35, 65 + Math.sin(t * 4) * 8, 1);

        // Fireworks bursts
        for (let f = 0; f < 3; f++) {
          const fx = TW * (0.25 + f * 0.25);
          const fy = TH * 0.22;
          for (let p = 0; p < 8; p++) {
            const ang = (p / 8) * 6.28;
            const r = (t * 50 + f * 20) % 45;
            tq.fillStyle = ['#ff4d79', '#f6d289', '#00f2fe'][f];
            tq.beginPath();
            tq.arc(fx + Math.cos(ang) * r, fy + Math.sin(ang) * r, 2.5, 0, 6.28);
            tq.fill();
          }
        }
        tq.restore();
      }

      actProgress += 0.003;
      if (actProgress > 1) {
        actProgress = 0;
        setTheatreAct((currentAct + 1) % THEATRE_ACTS.length);
      }
    }
    requestAnimationFrame(theatreLoop);

    function setTheatreAct(idx) {
      currentAct = idx;
      actProgress = 0;
      const data = THEATRE_ACTS[idx];
      $('#theatre-badge').textContent = data.badge;
      $('#theatre-sub-badge').textContent = data.sub;
      $('#dialog-speaker').textContent = data.speaker;
      $('#dialog-text').textContent = data.text;

      // Sync navigation chip buttons
      document.querySelectorAll('.hok-chip').forEach((c, i) => {
        c.classList.toggle('active', i === idx);
      });

      // Animate Champion Cards positions
      const kCard = $('#champ-kim'), zCard = $('#champ-zhi');
      if (kCard && zCard) {
        kCard.style.transform = `scale(${data.kimScale})`;
        zCard.style.transform = `scale(${data.zhiScale})`;
      }
    }

    document.querySelectorAll('.hok-chip').forEach(chip => {
      chip.onclick = () => {
        const act = parseInt(chip.dataset.act, 10);
        setTheatreAct(act);
      };
    });

    $('#btn-replay').onclick = () => {
      setTheatreAct(0);
      isTheatrePaused = false;
    };
    $('#btn-toggle-play').onclick = () => {
      isTheatrePaused = !isTheatrePaused;
    };

    /* ==========================================================================
       11. LOVE CONTRACT INTERACTION (Wax Seal Stamp with Confetti)
       ========================================================================== */
    $('#seal-btn').onclick = () => {
      const btn = $('#seal-btn');
      btn.classList.add('sealed');
      btn.innerHTML = '<span>已约</span>';
      $('#seal-tip').textContent = '♡ 契约已盖章生效 · 终身守护 · 2026.09.05 ♡';
      $('#seal-tip').style.color = '#70e69b';
      const r = btn.getBoundingClientRect();
      spawnClickBurst(r.left + r.width / 2, r.top + r.height / 2);
    };

    /* ==========================================================================
       12. METEOR WISH FOUNTAIN (Shooting Stars across the screen)
       ========================================================================== */
    $('#meteor-btn').onclick = () => {
      for (let i = 0; i < 7; i++) {
        setTimeout(() => {
          spawnMeteor(true);
        }, i * 200);
      }
      const r = $('#meteor-btn').getBoundingClientRect();
      spawnClickBurst(r.left + r.width / 2, r.top + r.height / 2);
    };

    /* ==========================================================================
       13. 520 REASONS GENERATOR
       ========================================================================== */
    const REASONS = [
      "喜欢你打完游戏问我累不累时的温柔语气。",
      "喜欢你认真吃饭时微微鼓起的可爱腮帮子。",
      "喜欢你戴着眼镜冲我害羞笑起来时的干净清澈。",
      "喜欢你在王者峡谷里紧紧跟着我，把后背交给我的信任。",
      "喜欢每天打开微信，第一眼看到的是你的消息。",
      "喜欢你偶尔的小傲娇，让我忍不住想把全世界都买给你。",
      "喜欢你听我讲冷笑话时，明明很冷却还是笑出声来的包容。",
      "喜欢你发来的每一张自拍，每一张我都偷偷存在加密相册里。",
      "喜欢我们之间慢慢热烈起来的默契，不急不躁，恰到好处。",
      "2026年9月5日牽住你的那一刻，我就知道你是我的命中注定。"
    ];
    let reasonIndex = 0;
    $('#next-reason-btn').onclick = () => {
      reasonIndex = (reasonIndex + 1) % REASONS.length;
      const rText = $('#r-text'), rIdx = $('#r-index');
      rText.style.opacity = 0;
      setTimeout(() => {
        rIdx.textContent = `REASON #${reasonIndex + 1}`;
        rText.textContent = REASONS[reasonIndex];
        rText.style.opacity = 1;
      }, 250);
    };

    /* ==========================================================================
       14. FINALE BIG HEART COUNTER
       ========================================================================== */
    let heartCount = 1314;
    $('#bigheart').onclick = e => {
      heartCount++;
      $('#heart-count').textContent = heartCount;
      const r = $('#bigheart').getBoundingClientRect();
      spawnClickBurst(r.left + r.width / 2, r.top + r.height / 2);
    };
  </script>
</body>
</html>