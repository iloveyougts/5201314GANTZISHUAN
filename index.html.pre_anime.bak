<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>颜芷萱 ♥ Kim | 我们的心动故事 · 2026.09.05</title>
  <meta name="description" content="Kim送给颜芷萱的专属浪漫网站，从王者峡谷相遇、交换微信长聊，到2026年9月5日相伴一生。">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --night: #080412;
      --deep-purple: #140a24;
      --wine: #260e2a;
      --rose: #ff4d79;
      --rose-soft: #ff85a2;
      --rose-glow: rgba(255, 77, 121, 0.45);
      --gold: #f6d289;
      --gold-glow: rgba(246, 210, 137, 0.4);
      --cyan: #00f2fe;
      --cyan-glow: rgba(0, 242, 254, 0.45);
      --blush: #ffd6e0;
      --glass-bg: rgba(255, 255, 255, 0.05);
      --glass-border: rgba(255, 215, 226, 0.22);
      --mute: #b8a5b8;
      --serif: "Noto Serif SC", "Cormorant Garamond", serif;
      --hand: "Ma Shan Zheng", cursive;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }
    html, body {
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden;
      color: #fff;
      font-family: var(--serif);
      scroll-behavior: smooth;
      position: relative;
      -webkit-font-smoothing: antialiased;
      -webkit-text-size-adjust: 100%;
      /* Dynamic Layered Nebula & Aurora Borealis Background */
      background:
        radial-gradient(ellipse at 15% 10%, rgba(255, 77, 121, 0.22) 0%, transparent 45%),
        radial-gradient(ellipse at 85% 20%, rgba(112, 80, 240, 0.2) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 50%, rgba(246, 210, 137, 0.12) 0%, transparent 55%),
        radial-gradient(ellipse at 20% 80%, rgba(0, 242, 254, 0.14) 0%, transparent 45%),
        radial-gradient(ellipse at 80% 90%, rgba(255, 77, 121, 0.18) 0%, transparent 50%),
        linear-gradient(180deg, #070310 0%, #110722 25%, #0a0416 50%, #150928 75%, #05020c 100%);
      background-attachment: fixed;
    }

    /* Ambient Canvas (Nebula clouds, stars, shooting meteors, floating fireflies) */
    #bg-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
      transform: translateZ(0);
    }

    /* Foreground FX Canvas (Realistic 3D flower petals, glowing hearts, click sparks) */
    #fx-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 999999;
      pointer-events: none;
      transform: translateZ(0);
    }

    /* Floating Music Toggle Button */
    #mute-btn {
      position: fixed;
      z-index: 1000000;
      top: calc(env(safe-area-inset-top, 0px) + 0.9rem);
      right: 0.9rem;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1.5px solid var(--rose);
      background: rgba(20, 10, 30, 0.75);
      color: #fff;
      font-size: 1.15rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(10px);
      box-shadow: 0 0 16px var(--rose-glow);
      transition: transform 0.2s, background 0.2s;
    }
    #mute-btn:hover {
      transform: scale(1.08);
      background: rgba(255, 77, 121, 0.3);
    }
    #mute-btn.playing {
      animation: spinMusic 9s linear infinite;
    }
    @keyframes spinMusic { 100% { transform: rotate(360deg); } }

    /* Gate / Welcome Cover */
    #gate {
      position: fixed;
      inset: 0;
      z-index: 1000001;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 1.5rem;
      background: radial-gradient(ellipse at 50% 40%, rgba(42, 14, 46, 0.95), var(--night));
      backdrop-filter: blur(8px);
      cursor: pointer;
      transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.8s;
    }
    #gate.off {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .gate-heart {
      width: 86px;
      height: 86px;
      margin-bottom: 1.5rem;
      animation: pulseBeat 1.8s ease-in-out infinite;
      filter: drop-shadow(0 0 30px var(--rose));
    }
    @keyframes pulseBeat {
      0%, 100% { transform: scale(1); filter: drop-shadow(0 0 18px var(--rose)); }
      15% { transform: scale(1.22); filter: drop-shadow(0 0 40px var(--rose)); }
      30% { transform: scale(1.04); }
      45% { transform: scale(1.15); filter: drop-shadow(0 0 30px var(--rose)); }
    }
    .gate-title {
      font-family: var(--hand), var(--serif);
      font-size: clamp(2.8rem, 11vw, 5.5rem);
      font-weight: 400;
      color: #fff;
      text-shadow: 0 0 25px var(--rose-glow), 0 0 60px rgba(255, 77, 121, 0.4);
      margin-bottom: 0.4rem;
      line-height: 1.15;
    }
    .gate-sub {
      font-family: var(--serif);
      color: var(--gold);
      font-size: clamp(0.95rem, 3.2vw, 1.4rem);
      letter-spacing: 0.18em;
      margin-bottom: 1.8rem;
    }
    .gate-btn {
      padding: 0.75rem 2.2rem;
      background: linear-gradient(135deg, var(--rose), #ff85a2);
      border: none;
      border-radius: 99px;
      color: #fff;
      font-size: clamp(0.92rem, 3vw, 1.1rem);
      font-family: var(--serif);
      cursor: pointer;
      box-shadow: 0 8px 30px var(--rose-glow);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .gate-btn:hover {
      transform: scale(1.05);
      box-shadow: 0 10px 40px rgba(255, 77, 121, 0.7);
    }
    .gate-tip {
      margin-top: 1.2rem;
      font-size: 0.8rem;
      color: var(--mute);
      letter-spacing: 0.1em;
    }

    /* Container & Base Reveal */
    .container {
      width: 92%;
      max-width: 1080px;
      margin: 0 auto;
      box-sizing: border-box;
      position: relative;
    }
    section {
      padding: 4.8rem 0;
      position: relative;
      z-index: 1;
    }
    .sec-tag {
      display: inline-block;
      font-family: var(--serif);
      font-style: italic;
      color: var(--gold);
      font-size: 0.95rem;
      letter-spacing: 0.15em;
      margin-bottom: 0.4rem;
      text-align: center;
      width: 100%;
    }
    .sec-title {
      font-family: var(--hand), var(--serif);
      font-size: clamp(2.2rem, 6.5vw, 3.8rem);
      color: #fff;
      text-shadow: 0 0 25px var(--rose-glow);
      text-align: center;
      margin-bottom: 0.6rem;
      font-weight: 400;
      line-height: 1.2;
    }
    .sec-sub {
      text-align: center;
      color: var(--blush);
      max-width: 640px;
      margin: 0 auto 2.5rem;
      font-size: clamp(0.88rem, 2.6vw, 1.05rem);
      line-height: 1.75;
      opacity: 0.9;
    }
    .reveal {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.8s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .reveal.in {
      opacity: 1;
      transform: none;
    }

    /* ---- 1. HERO SECTION ---- */
    #hero {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 3.5rem 0.8rem 2.5rem;
      position: relative;
      box-sizing: border-box;
    }
    .hero-tag {
      font-family: var(--serif);
      font-style: italic;
      font-size: clamp(1.3rem, 3.8vw, 2.2rem);
      color: var(--blush);
      text-shadow: 0 0 18px var(--rose-glow);
      margin-bottom: 0.2rem;
    }

    /* HERO NAME WRAP & NAME HEART CANVAS */
    .hero-name-wrap {
      position: relative;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1rem;
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
    }
    #name-heart-canvas {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      z-index: 1;
    }
    .hero-name {
      font-family: var(--hand), var(--serif);
      font-size: clamp(3.4rem, 13vw, 7.8rem);
      color: #fff;
      text-shadow: 0 0 25px rgba(255, 150, 180, 0.95), 0 0 65px rgba(255, 77, 121, 0.7);
      line-height: 1.1;
      margin: 0.05em 0;
      position: relative;
      z-index: 2;
    }
    .hero-pin {
      font-family: var(--serif);
      letter-spacing: 0.45em;
      color: var(--gold);
      font-size: clamp(0.85rem, 2.8vw, 1.35rem);
      position: relative;
      z-index: 2;
      margin-left: 0.4em;
    }

    /* Multilingual box with FIXED height to prevent layout jump */
    #cycle-box {
      margin: 1.2rem 0;
      height: 4.2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    #cycle-box b {
      display: block;
      font-weight: 400;
      font-size: clamp(1.35rem, 4.2vw, 2.1rem);
      color: var(--blush);
      transition: opacity 0.4s, transform 0.4s;
    }
    #cycle-box small {
      color: var(--mute);
      font-size: 0.85rem;
      transition: opacity 0.4s;
      letter-spacing: 0.2em;
      margin-top: 0.2rem;
    }
    #cycle-box.out b, #cycle-box.out small {
      opacity: 0;
      transform: translateY(-6px);
    }

    /* Love Timer Card: 2026.09.05 */
    .timer-card {
      margin-top: 1.2rem;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 77, 121, 0.08));
      border: 1.5px solid var(--glass-border);
      border-radius: 22px;
      padding: 1.3rem 1rem;
      backdrop-filter: blur(14px);
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35), 0 0 25px rgba(255, 77, 121, 0.18);
      max-width: 540px;
      width: 95%;
      position: relative;
      overflow: hidden;
      box-sizing: border-box;
    }
    .timer-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--rose), var(--gold), transparent);
    }
    .timer-header {
      font-size: clamp(0.92rem, 2.9vw, 1.05rem);
      color: var(--gold);
      margin-bottom: 0.3rem;
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    .timer-date-badge {
      display: inline-block;
      font-size: 0.78rem;
      color: var(--rose);
      background: rgba(255, 77, 121, 0.15);
      border: 1px solid rgba(255, 77, 121, 0.4);
      padding: 0.2rem 0.8rem;
      border-radius: 99px;
      margin-bottom: 0.9rem;
      letter-spacing: 0.08em;
    }
    .timer-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
    }
    .timer-unit {
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 215, 226, 0.16);
      border-radius: 12px;
      padding: 0.65rem 0.2rem;
      box-shadow: inset 0 0 12px rgba(255, 77, 121, 0.08);
    }
    .timer-num {
      font-size: clamp(1.4rem, 4.8vw, 2.3rem);
      font-family: var(--serif);
      font-weight: 600;
      color: #fff;
      line-height: 1.1;
      text-shadow: 0 0 16px var(--rose);
    }
    .timer-lbl {
      font-size: 0.74rem;
      color: var(--mute);
      margin-top: 0.2rem;
      letter-spacing: 0.08em;
    }
    .timer-footer {
      margin-top: 0.9rem;
      font-size: 0.82rem;
      color: var(--blush);
      opacity: 0.88;
      font-style: italic;
    }

    /* ---- 2. STORY TIMELINE ---- */
    .story-timeline {
      position: relative;
      max-width: 860px;
      margin: 0 auto;
    }
    .story-timeline::before {
      content: "";
      position: absolute;
      left: 20px;
      top: 25px;
      bottom: 25px;
      width: 2px;
      background: linear-gradient(to bottom, var(--rose), var(--gold), var(--rose));
      opacity: 0.5;
    }
    @media (min-width: 768px) {
      .story-timeline::before {
        left: 50%;
        transform: translateX(-50%);
      }
    }
    .story-step {
      position: relative;
      margin-bottom: 2.8rem;
      display: flex;
      flex-direction: column;
    }
    @media (min-width: 768px) {
      .story-step {
        flex-direction: row;
        align-items: center;
      }
      .story-step:nth-child(even) {
        flex-direction: row-reverse;
      }
    }
    .step-dot {
      position: absolute;
      left: 20px;
      top: 1.2rem;
      transform: translateX(-50%);
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--night);
      border: 3px solid var(--rose);
      box-shadow: 0 0 15px var(--rose);
      z-index: 2;
    }
    @media (min-width: 768px) {
      .step-dot {
        left: 50%;
      }
    }
    .step-card {
      margin-left: 45px;
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 77, 121, 0.06));
      border: 1px solid var(--glass-border);
      border-radius: 18px;
      padding: 1.3rem 1.1rem;
      backdrop-filter: blur(14px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.28);
      transition: transform 0.3s, border-color 0.3s;
    }
    @media (min-width: 768px) {
      .step-card {
        margin-left: 0;
        padding: 1.8rem;
        width: 44%;
      }
      .story-step:nth-child(odd) .step-card {
        margin-right: auto;
      }
      .story-step:nth-child(even) .step-card {
        margin-left: auto;
      }
    }
    .step-badge {
      display: inline-block;
      padding: 0.25rem 0.8rem;
      border-radius: 99px;
      font-size: 0.74rem;
      letter-spacing: 0.08em;
      margin-bottom: 0.6rem;
      font-family: var(--serif);
    }
    .badge-game {
      background: rgba(143, 168, 216, 0.2);
      color: #a4c4ff;
      border: 1px solid rgba(143, 168, 216, 0.45);
    }
    .badge-wechat {
      background: rgba(7, 193, 96, 0.2);
      color: #70e69b;
      border: 1px solid rgba(7, 193, 96, 0.45);
    }
    .badge-chat {
      background: rgba(246, 210, 137, 0.2);
      color: var(--gold);
      border: 1px solid rgba(246, 210, 137, 0.45);
    }
    .badge-love {
      background: rgba(255, 77, 121, 0.25);
      color: #ff94ab;
      border: 1px solid rgba(255, 77, 121, 0.5);
    }
    .step-title {
      font-size: clamp(1.15rem, 3.4vw, 1.38rem);
      color: #fff;
      margin-bottom: 0.5rem;
      font-weight: 600;
    }
    .step-body {
      font-size: 0.9rem;
      color: var(--blush);
      line-height: 1.75;
      opacity: 0.92;
    }
    .step-highlight {
      margin-top: 0.7rem;
      padding-top: 0.6rem;
      border-top: 1px dashed rgba(255, 215, 226, 0.18);
      font-style: italic;
      color: var(--gold);
      font-size: 0.88rem;
    }

    /* ---- 3. WECHAT CHAT SIMULATOR ---- */
    .chat-container {
      max-width: 520px;
      width: 95%;
      margin: 0 auto;
      background: #14131b;
      border: 1.5px solid rgba(255, 215, 226, 0.22);
      border-radius: 24px;
      box-shadow: 0 16px 50px rgba(0, 0, 0, 0.65), 0 0 30px rgba(255, 77, 121, 0.16);
      overflow: hidden;
    }
    .chat-phone-bar {
      background: #1e1b2b;
      padding: 0.8rem 1.1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .chat-phone-title {
      font-weight: 600;
      color: #fff;
      font-size: 1.02rem;
    }
    .chat-phone-sub {
      font-size: 0.75rem;
      color: #70e69b;
    }
    .chat-tabs {
      display: flex;
      background: rgba(255, 255, 255, 0.03);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .chat-tab-btn {
      flex: 1;
      min-width: 0;
      padding: 0.75rem 0.25rem;
      background: none;
      border: none;
      color: var(--mute);
      font-size: 0.78rem;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: color 0.2s, border-color 0.2s;
      text-align: center;
      white-space: nowrap;
    }
    .chat-tab-btn.active {
      color: #fff;
      border-bottom-color: var(--rose);
      background: rgba(255, 77, 121, 0.1);
    }
    .chat-body {
      height: 340px;
      overflow-y: auto;
      padding: 1rem 0.8rem;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      background: #0d0a14;
    }
    .chat-bubble-row {
      display: flex;
      align-items: flex-end;
      gap: 0.5rem;
    }
    .chat-bubble-row.boy {
      flex-direction: row-reverse;
    }
    .chat-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: bold;
      color: #fff;
    }
    .chat-avatar.girl-av {
      background: linear-gradient(135deg, #ff7597, #ff4d79);
      box-shadow: 0 0 10px rgba(255, 77, 121, 0.4);
    }
    .chat-avatar.boy-av {
      background: linear-gradient(135deg, #4facfe, #00f2fe);
      box-shadow: 0 0 10px rgba(79, 172, 254, 0.4);
    }
    .chat-bubble {
      max-width: 80%;
      padding: 0.65rem 0.9rem;
      border-radius: 14px;
      font-size: 0.88rem;
      line-height: 1.5;
      word-break: break-word;
      animation: bubblePop 0.3s ease-out;
    }
    @keyframes bubblePop {
      0% { opacity: 0; transform: scale(0.92); }
      100% { opacity: 1; transform: scale(1); }
    }
    .chat-bubble.girl-msg {
      background: rgba(255, 255, 255, 0.12);
      color: #fff;
      border-bottom-left-radius: 3px;
      border: 1px solid rgba(255, 215, 226, 0.15);
    }
    .chat-bubble.boy-msg {
      background: linear-gradient(135deg, rgba(7, 193, 96, 0.85), rgba(5, 160, 80, 0.85));
      color: #fff;
      border-bottom-right-radius: 3px;
    }
    .chat-time-center {
      text-align: center;
      font-size: 0.72rem;
      color: var(--mute);
      margin: 0.3rem 0;
    }
    .chat-actions {
      padding: 0.7rem 1rem;
      background: #191624;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .chat-status-text {
      font-size: 0.75rem;
      color: var(--mute);
    }
    .chat-btn {
      background: var(--rose);
      border: none;
      color: #fff;
      font-size: 0.82rem;
      padding: 0.45rem 1rem;
      border-radius: 99px;
      cursor: pointer;
      box-shadow: 0 3px 14px rgba(255, 77, 121, 0.45);
      transition: transform 0.2s;
    }
    .chat-btn:hover {
      transform: scale(1.05);
    }

    /* ==========================================================================
       4. CINEMATIC HONOR OF KINGS ANIME THEATRE (Ultra-HD Visual Novel Presentation)
       - NO MORE CRUDE STICK FIGURES!
       - Anime Champion Cards, Glowing Sigils, Spell Beams, Particle Fireworks
       ========================================================================== */
    #game-wrap {
      max-width: 880px;
      width: 95%;
      margin: 0 auto;
      border-radius: 22px;
      overflow: hidden;
      border: 2px solid rgba(246, 210, 137, 0.4);
      box-shadow: 0 16px 50px rgba(0, 0, 0, 0.65), 0 0 35px rgba(255, 77, 121, 0.22);
      background: #0e0a1a;
      position: relative;
    }
    .hok-header-bar {
      background: linear-gradient(90deg, #120c24, #271438, #120c24);
      border-bottom: 1.5px solid rgba(246, 210, 137, 0.35);
      padding: 0.65rem 1.1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .hok-title-wrap {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .hok-crest-icon {
      width: 26px;
      height: 26px;
      background: linear-gradient(135deg, #f6d289, #d49a37);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      color: #260a25;
      font-size: 0.8rem;
      box-shadow: 0 0 8px rgba(246, 210, 137, 0.8);
    }
    .hok-game-title {
      font-weight: 700;
      color: #fff;
      font-size: clamp(0.88rem, 2.8vw, 1.02rem);
      letter-spacing: 0.05em;
      text-shadow: 0 0 8px rgba(246, 210, 137, 0.5);
    }
    .hok-match-score {
      font-family: var(--serif);
      font-size: clamp(0.78rem, 2.5vw, 0.95rem);
      color: #70e69b;
      letter-spacing: 0.1em;
      background: rgba(0, 0, 0, 0.4);
      padding: 0.2rem 0.65rem;
      border-radius: 99px;
      border: 1px solid rgba(112, 230, 155, 0.3);
    }

    /* THEATRE STAGE BOX */
    #theatre-stage {
      position: relative;
      width: 100%;
      height: clamp(300px, 46vh, 420px);
      overflow: hidden;
      background: radial-gradient(ellipse at 50% 30%, #1c1032, #0a0614);
    }
    #theatre-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      display: block;
    }

    /* Champion Dual Cards Layer */
    .champions-layer {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 2rem;
      pointer-events: none;
    }
    @media (max-width: 600px) {
      .champions-layer {
        padding: 1rem 0.8rem;
      }
    }
    .champ-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      transition: transform 0.4s ease, opacity 0.4s ease;
    }
        .champ-avatar-box {
      width: clamp(96px, 22vw, 138px);
      height: clamp(96px, 22vw, 138px);
      border-radius: 50%;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 35px rgba(0, 0, 0, 0.85);
      transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .champ-card:hover .champ-avatar-box {
      transform: scale(1.08);
    }
    .champ-rune-ring {
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      border: 2px dashed var(--gold);
      animation: spinRune 15s linear infinite;
      pointer-events: none;
    }
    @keyframes spinRune { 100% { transform: rotate(360deg); } }
    .champ-kim .champ-avatar-box {
      box-shadow: 0 0 35px var(--cyan-glow);
    }
    .champ-kim .champ-rune-ring {
      border-color: var(--cyan);
    }
    .champ-zhi .champ-avatar-box {
      box-shadow: 0 0 35px var(--rose-glow);
    }
    .champ-zhi .champ-rune-ring {
      border-color: var(--rose);
    }
    .champ-avatar-img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      display: block;
      border: 2.5px solid #fff;
      transition: transform 0.4s ease;
    }
    .champ-card:hover .champ-avatar-img {
      transform: scale(1.06);
    }
    .champ-lvl-badge {
      position: absolute;
      bottom: 2px;
      right: 2px;
      background: linear-gradient(135deg, #f6d289, #d49a37);
      color: #1a0a20;
      font-weight: 800;
      font-size: 0.68rem;
      padding: 0.15rem 0.48rem;
      border-radius: 99px;
      box-shadow: 0 0 8px rgba(246, 210, 137, 0.8);
      border: 1px solid #fff;
    }
    .champ-tag {
      margin-top: 0.6rem;
      font-weight: 700;
      font-size: clamp(0.85rem, 2.5vw, 1.05rem);
      letter-spacing: 0.05em;
      white-space: nowrap;
    }
    .champ-kim .champ-tag {
      color: #9fc0ff;
      text-shadow: 0 0 10px var(--cyan-glow);
    }
    .champ-zhi .champ-tag {
      color: #ffb3c1;
      text-shadow: 0 0 10px var(--rose-glow);
    }
    .champ-subtag {
      font-size: 0.74rem;
      color: var(--gold);
      margin-top: 0.15rem;
      letter-spacing: 0.05em;
    }
    .champ-hp-bar {
      width: clamp(75px, 18vw, 105px);
      height: 6px;
      border-radius: 99px;
      background: rgba(255, 255, 255, 0.15);
      margin-top: 0.4rem;
      overflow: hidden;
      border: 0.5px solid rgba(255, 255, 255, 0.2);
    }
    .champ-hp-fill {
      width: 100%;
      height: 100%;
      background: #70e69b;
      box-shadow: 0 0 6px #70e69b;
    }
    .champ-kda {
      font-size: 0.72rem;
      color: #70e69b;
      margin-top: 0.25rem;
      letter-spacing: 0.05em;
      font-family: var(--serif);
      font-weight: 600;
    }

    .theatre-center-fx {
      position: absolute;
      top: 25%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 3;
      text-align: center;
      pointer-events: none;
      width: 90%;
    }
    .theatre-badge-pill {
      display: inline-block;
      font-size: clamp(0.85rem, 2.8vw, 1.15rem);
      font-weight: 700;
      color: #fff;
      padding: 0.35rem 1.2rem;
      border-radius: 99px;
      background: rgba(14, 10, 26, 0.8);
      border: 1px solid var(--gold);
      box-shadow: 0 0 20px rgba(246, 210, 137, 0.4);
      margin-bottom: 0.4rem;
      animation: floatBadge 2.5s ease-in-out infinite;
    }
    @keyframes floatBadge {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-5px); }
    }
    .theatre-sub-fx {
      font-size: clamp(0.78rem, 2.4vw, 0.95rem);
      color: var(--gold);
      text-shadow: 0 0 10px rgba(0, 0, 0, 0.8);
    }

    /* Dialogue Card on bottom of stage */
    .theatre-dialog-box {
      position: absolute;
      bottom: 0.8rem;
      left: 5%;
      right: 5%;
      z-index: 4;
      background: rgba(16, 11, 28, 0.88);
      border: 1.5px solid rgba(246, 210, 137, 0.35);
      border-radius: 14px;
      padding: 0.65rem 1.2rem;
      backdrop-filter: blur(8px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6);
      text-align: center;
    }
    .theatre-dialog-speaker {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--gold);
      margin-bottom: 0.2rem;
      letter-spacing: 0.08em;
    }
    .theatre-dialog-text {
      font-size: clamp(0.85rem, 2.7vw, 1.05rem);
      color: #fff;
      line-height: 1.45;
      font-weight: 600;
      text-shadow: 0 0 10px rgba(255, 77, 121, 0.4);
    }

    .game-controls {
      padding: 0.7rem 1rem;
      background: #130c22;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .hok-chapters-nav {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 0.4rem;
      padding-bottom: 2px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .hok-chip {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(246, 210, 137, 0.3);
      color: var(--blush);
      padding: 0.3rem 0.7rem;
      border-radius: 99px;
      font-size: 0.75rem;
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
      transition: background 0.2s, border-color 0.2s, color 0.2s;
    }
    .hok-chip:hover, .hok-chip.active {
      background: rgba(255, 77, 121, 0.25);
      border-color: var(--rose);
      color: #fff;
    }
    .game-ctrl-btns {
      display: flex;
      gap: 0.5rem;
      justify-content: center;
    }
    .game-ctrl-btn {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 215, 226, 0.22);
      color: var(--blush);
      padding: 0.35rem 0.9rem;
      border-radius: 99px;
      font-size: 0.78rem;
      cursor: pointer;
      transition: background 0.2s;
    }
    .game-ctrl-btn:hover {
      background: rgba(255, 77, 121, 0.25);
      border-color: var(--rose);
    }

    /* ---- 5. PHOTO GALLERY ---- */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.9rem;
      max-width: 900px;
      margin: 0 auto;
    }
    @media (min-width: 680px) {
      .gallery-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
      }
    }
    .photo-card {
      background: linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(255, 77, 121, 0.05));
      border: 1.5px solid rgba(246, 210, 137, 0.45);
      border-radius: 18px;
      padding: 0.7rem;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35), 0 0 20px rgba(255, 77, 121, 0.15);
      transition: transform 0.3s, border-color 0.3s;
      display: flex;
      flex-direction: column;
      cursor: pointer;
    }
    .photo-card:hover {
      transform: translateY(-5px);
      border-color: var(--gold);
    }
    .photo-img-wrap {
      width: 100%;
      aspect-ratio: 4 / 5;
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      border: 1px solid rgba(255, 255, 255, 0.12);
    }
    .photo-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s;
    }
    .photo-card:hover .photo-img-wrap img {
      transform: scale(1.05);
    }
    .photo-caption {
      margin-top: 0.6rem;
      text-align: center;
    }
    .photo-title {
      color: var(--gold);
      font-size: clamp(0.85rem, 2.5vw, 1.05rem);
      font-weight: 600;
      margin-bottom: 0.2rem;
    }
    .photo-desc {
      font-size: 0.76rem;
      color: var(--blush);
      line-height: 1.45;
      opacity: 0.9;
    }

    /* ---- 6. LOVE LETTER ---- */
    .envelope-wrap {
      max-width: 720px;
      width: 95%;
      margin: 0 auto;
    }
    .letter-box {
      background: linear-gradient(150deg, #1b1429, #130d20);
      border: 1.5px solid rgba(246, 210, 137, 0.45);
      border-radius: 22px;
      padding: 1.8rem 1.3rem;
      box-shadow: 0 16px 50px rgba(0, 0, 0, 0.55), 0 0 30px rgba(255, 77, 121, 0.18);
      position: relative;
    }
    @media (min-width: 768px) {
      .letter-box {
        padding: 2.8rem 2.2rem;
      }
    }
    .letter-salutation {
      font-size: clamp(1.15rem, 3.5vw, 1.45rem);
      color: var(--gold);
      font-weight: 600;
      margin-bottom: 1.2rem;
    }
    .letter-content p {
      font-size: clamp(0.88rem, 2.6vw, 1.02rem);
      line-height: 1.9;
      color: #fff;
      margin-bottom: 1rem;
      opacity: 0.94;
    }
    .letter-sign {
      margin-top: 1.8rem;
      text-align: right;
      font-family: var(--hand), var(--serif);
      font-size: clamp(1.4rem, 4vw, 2.1rem);
      color: var(--gold);
    }
    .letter-date {
      font-family: var(--serif);
      font-size: 0.85rem;
      color: var(--mute);
      margin-top: 0.3rem;
      letter-spacing: 0.1em;
    }

    /* ==========================================================================
       NEW ROMANTIC FEATURE 1: 《恋人专属浪漫契约》(Love Contract)
       ========================================================================== */
    .contract-wrap {
      max-width: 740px;
      width: 95%;
      margin: 0 auto;
      background: radial-gradient(ellipse at 50% 30%, #201335, #11091d);
      border: 2px solid var(--gold);
      border-radius: 24px;
      padding: 2.2rem 1.6rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7), 0 0 40px rgba(246, 210, 137, 0.25);
      position: relative;
      overflow: hidden;
    }
    @media (min-width: 768px) {
      .contract-wrap {
        padding: 3rem 2.8rem;
      }
    }
    .contract-corner {
      position: absolute;
      width: 24px;
      height: 24px;
      border: 2px solid var(--gold);
    }
    .contract-corner.tl { top: 10px; left: 10px; border-right: none; border-bottom: none; }
    .contract-corner.tr { top: 10px; right: 10px; border-left: none; border-bottom: none; }
    .contract-corner.bl { bottom: 10px; left: 10px; border-right: none; border-top: none; }
    .contract-corner.br { bottom: 10px; right: 10px; border-left: none; border-top: none; }

    .contract-header {
      text-align: center;
      margin-bottom: 1.8rem;
    }
    .contract-title {
      font-family: var(--hand), var(--serif);
      font-size: clamp(2rem, 5.5vw, 3.2rem);
      color: var(--gold);
      text-shadow: 0 0 20px rgba(246, 210, 137, 0.5);
    }
    .contract-sub {
      font-size: 0.85rem;
      color: var(--blush);
      letter-spacing: 0.15em;
      margin-top: 0.3rem;
    }
    .contract-parties {
      display: flex;
      justify-content: space-around;
      background: rgba(255, 255, 255, 0.04);
      border: 1px dashed rgba(246, 210, 137, 0.3);
      border-radius: 16px;
      padding: 1rem;
      margin-bottom: 1.6rem;
    }
    .party-col {
      text-align: center;
    }
    .party-label {
      font-size: 0.76rem;
      color: var(--mute);
    }
    .party-name {
      font-weight: 700;
      font-size: 1.1rem;
      color: #fff;
      margin-top: 0.2rem;
    }
    .contract-clauses {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
      margin-bottom: 2rem;
    }
    .clause-item {
      display: flex;
      gap: 0.8rem;
      align-items: flex-start;
      background: rgba(0, 0, 0, 0.25);
      border-radius: 12px;
      padding: 0.85rem 1rem;
      border: 1px solid rgba(255, 215, 226, 0.1);
    }
    .clause-num {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--gold);
      color: #1a0a20;
      font-weight: 800;
      font-size: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 0.1rem;
    }
    .clause-text {
      font-size: 0.9rem;
      color: #fff;
      line-height: 1.6;
    }
    .contract-footer {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
    .wax-seal-btn {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: radial-gradient(circle, #e74c3c, #962d22);
      border: 3px solid #ff7979;
      box-shadow: 0 0 25px rgba(231, 76, 60, 0.6);
      color: #fff;
      font-family: var(--hand);
      font-size: 1.3rem;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s, box-shadow 0.2s;
      animation: sealPulse 2.2s infinite;
    }
    @keyframes sealPulse {
      0%, 100% { transform: scale(1); box-shadow: 0 0 20px rgba(231, 76, 60, 0.5); }
      50% { transform: scale(1.08); box-shadow: 0 0 35px rgba(231, 76, 60, 0.85); }
    }
    .wax-seal-btn:hover {
      transform: scale(1.12);
    }
    .wax-seal-btn.sealed {
      background: radial-gradient(circle, #27ae60, #196f3d);
      border-color: #70e69b;
      box-shadow: 0 0 30px rgba(39, 174, 96, 0.7);
      animation: none;
    }
    .seal-tip {
      font-size: 0.82rem;
      color: var(--gold);
      letter-spacing: 0.1em;
    }

    /* ==========================================================================
       NEW ROMANTIC FEATURE 2: 《写给芷萱的复古黑胶唱片机》(Vinyl Player)
       ========================================================================== */
    .vinyl-box {
      max-width: 600px;
      width: 95%;
      margin: 0 auto;
      background: linear-gradient(145deg, #1b122c, #0e0818);
      border: 1.5px solid rgba(246, 210, 137, 0.35);
      border-radius: 24px;
      padding: 2rem 1.4rem;
      box-shadow: 0 16px 50px rgba(0, 0, 0, 0.65);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .vinyl-record-wrap {
      width: 170px;
      height: 170px;
      border-radius: 50%;
      background: radial-gradient(circle, #2a2a2a, #0b0b0b 70%);
      border: 5px solid #111;
      box-shadow: 0 0 30px rgba(0, 0, 0, 0.9), 0 0 25px rgba(255, 77, 121, 0.25);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      transition: transform 0.5s ease;
    }
    .vinyl-record-wrap.spinning {
      animation: vinylSpin 6s linear infinite;
    }
    @keyframes vinylSpin { 100% { transform: rotate(360deg); } }
    .vinyl-grooves {
      position: absolute;
      inset: 12px;
      border-radius: 50%;
      border: 1px dashed rgba(255, 255, 255, 0.12);
    }
    .vinyl-label {
      width: 65px;
      height: 65px;
      border-radius: 50%;
      background: radial-gradient(circle, #ff4d79, #c0392b);
      border: 2px solid var(--gold);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 0.6rem;
      font-weight: 700;
      text-shadow: 0 0 5px rgba(0, 0, 0, 0.6);
    }
    .vinyl-center-hole {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #080410;
      border: 1px solid rgba(255, 255, 255, 0.3);
      margin-top: 2px;
    }
    .vinyl-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: #fff;
    }
    .vinyl-artist {
      font-size: 0.88rem;
      color: var(--gold);
      margin-top: 0.2rem;
    }
    .vinyl-dedication {
      font-size: 0.82rem;
      color: var(--blush);
      font-style: italic;
      margin: 0.8rem 0 1.2rem;
    }
    .vinyl-ctrl-btn {
      background: linear-gradient(135deg, var(--rose), #ff85a2);
      border: none;
      color: #fff;
      padding: 0.65rem 1.8rem;
      border-radius: 99px;
      font-size: 0.92rem;
      font-family: var(--serif);
      cursor: pointer;
      box-shadow: 0 6px 20px var(--rose-glow);
      transition: transform 0.2s;
    }
    .vinyl-ctrl-btn:hover {
      transform: scale(1.05);
    }

    /* ---- 7. 520 REASONS ---- */
    .reasons-box {
      max-width: 600px;
      width: 95%;
      margin: 0 auto;
      text-align: center;
    }
    .reason-card {
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 77, 121, 0.08));
      border: 1.5px solid var(--glass-border);
      border-radius: 20px;
      padding: 1.8rem 1.2rem;
      backdrop-filter: blur(14px);
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
      margin-bottom: 1.5rem;
    }
    .reason-num {
      font-size: 0.82rem;
      color: var(--gold);
      letter-spacing: 0.15em;
      margin-bottom: 0.6rem;
    }
    .reason-text {
      font-size: clamp(1.05rem, 3.4vw, 1.35rem);
      color: #fff;
      line-height: 1.65;
      min-height: 3.6rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.3s;
    }
    .reason-btn {
      background: linear-gradient(135deg, var(--rose), #ff85a2);
      border: none;
      color: #fff;
      padding: 0.7rem 2rem;
      border-radius: 99px;
      font-size: 0.92rem;
      font-family: var(--serif);
      cursor: pointer;
      box-shadow: 0 6px 20px var(--rose-glow);
      transition: transform 0.2s;
    }
    .reason-btn:hover {
      transform: scale(1.05);
    }

    /* ---- 8. FINALE HEART & METEOR WISH FOUNTAIN ---- */
    #finale {
      text-align: center;
      padding: 4rem 1rem 6rem;
    }
    .big-heart-btn {
      width: 86px;
      height: 86px;
      border: none;
      background: none;
      cursor: pointer;
      margin: 1.2rem auto;
      display: block;
      animation: pulseBeat 1.6s ease-in-out infinite;
      transition: transform 0.15s;
    }
    .big-heart-btn:active {
      transform: scale(0.9);
    }
    .heart-counter {
      font-size: 0.88rem;
      color: var(--mute);
      margin-top: 0.8rem;
    }
    .heart-counter span {
      color: var(--rose);
      font-weight: 700;
      font-size: 1.15rem;
    }
    .meteor-wish-btn {
      margin-top: 1.5rem;
      background: linear-gradient(135deg, #f6d289, #e67e22);
      border: none;
      color: #2b0c16;
      font-weight: 700;
      padding: 0.8rem 2.2rem;
      border-radius: 99px;
      font-size: 0.95rem;
      font-family: var(--serif);
      cursor: pointer;
      box-shadow: 0 8px 30px rgba(246, 210, 137, 0.5);
      transition: transform 0.2s;
    }
    .meteor-wish-btn:hover {
      transform: scale(1.06);
    }

    footer {
      text-align: center;
      padding: 2.5rem 1rem;
      color: var(--mute);
      font-size: 0.82rem;
      letter-spacing: 0.15em;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(0, 0, 0, 0.4);
    }
  </style>
</head>
<body>

  <!-- Dynamic Nebula, Stars & Shooting Meteors Canvas -->
  <canvas id="bg-canvas" aria-hidden="true"></canvas>

  <!-- Top-level FX canvas for realistic falling petals & click explosions -->
  <canvas id="fx-canvas" aria-hidden="true"></canvas>

  <!-- Audio element for Love Story (plays local lovestory.mp3, with online CDN fallback) -->
  <audio id="bgm" src="lovestory.mp3" loop preload="auto">
    <source src="lovestory.mp3" type="audio/mpeg">
    <source src="https://raw.githubusercontent.com/YiLin-East/MyMusic/main/Taylor%20Swift%20-%20Love%20Story.mp3" type="audio/mpeg">
